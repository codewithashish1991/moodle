O:26:"core_cache\version_wrapper":2:{s:4:"data";O:8:"stdClass":9:{s:7:"modinfo";a:4:{i:1;O:8:"stdClass":14:{s:2:"id";s:1:"1";s:2:"cm";s:1:"1";s:3:"mod";s:4:"page";s:7:"section";s:1:"1";s:9:"sectionid";s:1:"1";s:6:"module";s:2:"17";s:5:"added";s:10:"1651819670";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:18:"deletioninprogress";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"name";s:14:"Ladar Training";}i:2;O:8:"stdClass":15:{s:2:"id";s:1:"1";s:2:"cm";s:1:"2";s:3:"mod";s:5:"label";s:7:"section";s:1:"1";s:9:"sectionid";s:1:"1";s:6:"module";s:2:"14";s:5:"added";s:10:"1651819849";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"showdescription";s:1:"1";s:15:"downloadcontent";s:1:"1";s:4:"name";s:55:"Ladar™ Sensor Suite - Avoid Collisions. Save Lives...";s:7:"content";s:982:"<div class="no-overflow"><p dir="ltr" style="text-align: left;"></p><p><strong>Ladar™ Sensor Suite - Avoid Collisions. Save Lives. Meet Regulatory Compliance. Protect the Environment. Explore the Digitalized and Automated Future.</strong></p><p>At Ladar Limited, we design, develop, and deploy laser and computer vision – based technological solutions for the maritime and offshore industry.&nbsp; Our Ladar&nbsp;™&nbsp;Sensor Suite is a smart system that enables real-time, highly accurate surveillance of the ocean surface layer and the water column.&nbsp; The system uses sensor-based data and presents a visual consolidation of feeds – perfect for swift decision-making.&nbsp; Our Ladar&nbsp;™&nbsp;Sensor Suite&nbsp;prioritizes the safety of your crew, passengers, vessels, and cargo by utilizing artificial intelligence to fuse data aggregation systems into a comprehensive decision support system – available for you 24/7, around-the-clock.&nbsp;</p><p></p></div>";}i:3;O:8:"stdClass":14:{s:2:"id";s:1:"1";s:2:"cm";s:1:"3";s:3:"mod";s:4:"wiki";s:7:"section";s:1:"1";s:9:"se